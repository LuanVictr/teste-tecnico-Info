    {
      "_id": "fld_auth",
      "_type": "request_group",
      "name": "🔐 Autenticação",
      "description": "Endpoints de autenticação JWT",
      "parentId": "wrk_fleet"
    },
    {
      "_id": "req_auth_login",
      "_type": "request",
      "name": "Login",
      "description": "Autentica com email e senha. O access_token é salvo automaticamente no ambiente via script pós-resposta.",
      "method": "POST",
      "url": "{{ _.base_url }}/auth/login",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"aivacol@aivacol.com\",\n  \"password\": \"aivacol@123\"\n}"
      },
      "afterResponseScript": "const body = insomnia.response.json();\nif (body.access_token) {\n  insomnia.environment.set('access_token', body.access_token);\n  console.log('✅ access_token salvo no ambiente automaticamente');\n} else {\n  console.error('❌ access_token não encontrado na resposta');\n}",
      "parentId": "fld_auth"
    },
    {
      "_id": "req_auth_login_invalid",
      "_type": "request",
      "name": "Login — credenciais inválidas (401)",
      "description": "Deve retornar 401 Unauthorized",
      "method": "POST",
      "url": "{{ _.base_url }}/auth/login",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"wrong@email.com\",\n  \"password\": \"wrongpassword\"\n}"
      },
      "parentId": "fld_auth"
    },
    {
      "_id": "req_auth_no_token",
